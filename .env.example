# ==============================================================================
# CẤU HÌNH MÁY CHỦ ADAPTIVETUTOR AI (CÁCH 1: WEB TỰ ĐỨNG RA CHỊU API)
# ==============================================================================
# Hướng dẫn: Sao chép tệp này thành .env trên máy của bạn (không commit .env lên GitHub)
# Lệnh copy: cp .env.example .env

# 1. KHÓA BẢO MẬT HỆ THỐNG (BẮT BUỘC)
# Dùng để ký session token và xác thực phiên đăng nhập của học sinh
# Sinh khóa ngẫu nhiên bằng lệnh: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=doi-thanh-chuoi-ngau-nhien-dai-64-ky-tu-bao-mat-vi-du-1234567890abcdef

# 2. KHÓA GOOGLE GEMINI API (CÁCH 1: KHUYÊN DÙNG - HOÀN TOÀN MIỄN PHÍ)
# Lấy khóa miễn phí 100% tại: https://aistudio.google.com/app/apikey
# Gói Free Tier: 1.500 yêu cầu / ngày, 15 yêu cầu / phút, không cần thẻ tín dụng
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# 3. CÁC NHÀ CUNG CẤP AI KHÁC (TÙY CHỌN DỰ PHÒNG, ĐỂ TRỐNG NẾU DÙNG GEMINI)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5

# 4. GIỚI HẠN LƯỢT HỎI ĐỂ BẢO VỆ HẠN NGẠCH FREE TIER (1.500 LƯỢT/NGÀY)
LLM_DAILY_LIMIT=30          # Tối đa lượt hỏi AI mỗi ngày cho 1 học sinh đăng nhập
LLM_GUEST_DAILY_LIMIT=10    # Tối đa lượt hỏi AI mỗi ngày cho 1 địa chỉ IP khách
LLM_GLOBAL_DAILY_LIMIT=1200 # Trần bảo vệ toàn hệ thống mỗi ngày

# 5. CẤU HÌNH MẠNG VÀ CỔNG CHẠY
HOST=0.0.0.0
PORT=5000

# 6. GỬI MÃ ĐĂNG NHẬP EMAIL (0 = Chế độ chạy thật cần SMTP, 1 = Chế độ phát triển in mã ra console)
MAIL_DEV=1
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password_16_chars
# MAIL_FROM=AdaptiveTutor <your_email@gmail.com>
